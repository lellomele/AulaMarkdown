<Window x:Class="AulaMarkdown.AboutWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource Ui.AboutTitle}" Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/AulaMarkdown.ico" Background="{DynamicResource PanelBg}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13">
<Border Background="{DynamicResource PanelBg}" Padding="24"><StackPanel>
 <StackPanel Orientation="Horizontal"><Image Source="Assets/AulaMarkdown.png" Width="48" Height="48" Margin="0,0,14,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="AulaMarkdown" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="VersionLabel" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></StackPanel>
 <StackPanel Orientation="Horizontal" Margin="0,19,0,16"><Border Width="24" Height="16" BorderBrush="#808080" BorderThickness=".5" Margin="0,0,9,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#009246"/><Border Grid.Column="1" Background="White"/><Border Grid.Column="2" Background="#CE2B37"/></Grid></Border><TextBlock x:Name="CopyrightText" VerticalAlignment="Center" FontWeight="SemiBold"/></StackPanel>
 <TextBlock Text="{DynamicResource Ui.AboutDescription}" TextWrapping="Wrap"/>
 <TextBlock Margin="0,9,0,0" Text="{DynamicResource Ui.AboutFeatures}" TextWrapping="Wrap"/>
 <TextBlock Margin="0,14,0,0" Foreground="{DynamicResource MutedBrush}" Text="{DynamicResource Ui.AboutShortcuts}" TextWrapping="Wrap"/>
 <DockPanel Margin="0,22,0,0"><Button DockPanel.Dock="Right" Content="{DynamicResource Ui.Close}" IsCancel="True" IsDefault="True" Click="Close_Click" Padding="15,6"/><StackPanel Orientation="Horizontal"><Button Content="{DynamicResource Ui.Guide}" Click="Guide_Click" Padding="12,6" Margin="0,0,8,0"/><Button Content="{DynamicResource Ui.Licenses}" Click="Licenses_Click" Padding="12,6"/></StackPanel></DockPanel>
</StackPanel></Border></Window>